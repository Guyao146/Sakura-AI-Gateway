<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Sakura-AI-Gateway.WebView2</AssemblyName>
    <RootNamespace>SakuraAIGateway.WebView2</RootNamespace>
    <Product>Sakura-AI-Gateway</Product>
    <Title>Sakura-AI-Gateway · Edge WebView2</Title>
    <Version>3.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\shared\DesktopData.cs" Link="DesktopData.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="gateway\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="runtime\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>