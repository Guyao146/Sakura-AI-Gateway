{
  "name": "sakura-ai-gateway-electron",
  "version": "3.3.0",
  "private": true,
  "description": "Electron desktop client for Sakura-AI-Gateway",
  "repository": { "type": "git", "url": "git+https://github.com/Guyao146/Sakura-AI-Gateway.git" },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "cn.mcylyr.sakuraaigateway.electron",
    "productName": "Sakura-AI-Gateway Electron",
    "publish": [],
    "asar": true,
    "files": ["main.js", "preload.js", "data-directory.js", "package.json"],
    "extraResources": [{ "from": "gateway", "to": "gateway" }],
    "directories": { "output": "dist" },
    "win": {
      "artifactName": "Sakura-AI-Gateway-${version}-Electron-win-${arch}-${name}.${ext}",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Sakura-AI-Gateway-${version}-Electron-win-${arch}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Sakura-AI-Gateway-${version}-Electron-win-${arch}-Portable.${ext}"
    }
  }
}